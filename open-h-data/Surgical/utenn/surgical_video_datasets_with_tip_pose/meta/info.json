{
  "repo_id": "UTK_AURAS/surgical_actions_v2_with_tip2d",
  "dataset_format_version": "2.1",
  "lerobot_version": "0.3.3",
  "license": "CC BY 4.0",
  "robot_type": "davinci_xi",
  "use_videos": true,
  "fps": 30.0,
  "modalities": [
    "observation.images.color",
    "observation.images.depth",
    "observation.images.tool_segmentation"
  ],
  "additional_fields": {
    "observation.state.tip_2d": {
      "dtype": "float32",
      "shape": [
        "num_tools",
        3
      ],
      "names": [
        "x_px",
        "y_px",
        "theta_deg"
      ],
      "description": "2D tool tip pose per tool. Order corresponds to observation.meta.tool_name."
    },
    "observation.meta.tool_name": {
      "dtype": "string",
      "shape": [
        "num_tools"
      ],
      "description": "Tool name list matching the first dimension of observation.state.tip_2d."
    }
  },
  "splits": {
    "train": "0:55",
    "val": "55:58",
    "test": "58:62"
  },
  "num_episodes": 62,
  "chunking": {
    "chunks": [
      "chunk-000"
    ]
  },
  "notes": {
    "segmentation_source": "SAM3 optimized outputs (tool_mask_opt.mp4 only).",
    "depth_source": "VideoDepthAnything (DepthAnything v2 backbone).",
    "pose2d_source": "Friend-labeled 2D tool pose CSV per clip.",
    "timestep_table_columns": [
      "episode_index",
      "step_index",
      "timestamp_s",
      "action.label",
      "observation.meta.tool_name",
      "observation.state.tip_2d"
    ],
    "truncation_policy": "n_steps = min(rgb, depth, seg, pose_csv_len) using estimated frame counts"
  }
}